{
  "name": "goldseam",
  "version": "0.0.4",
  "description": "Self-healing for the Cypress suites you already have: failures become rich captures, your model (local or API) proposes a minimal selector fix, the suite verifies it, and it arrives as a pull request.",
  "license": "MIT",
  "exports": {
    "./support": {
      "types": "./dist/support/index.d.ts",
      "default": "./dist/support/index.js"
    },
    "./support/register": {
      "types": "./dist/support/register.d.ts",
      "default": "./dist/support/register.js"
    },
    "./plugin": {
      "types": "./dist/plugin/index.d.ts",
      "default": "./dist/plugin/index.js"
    },
    "./types": {
      "types": "./dist/shared/types.d.ts",
      "default": "./dist/shared/types.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "goldseam": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p ../aria-snapshot/tsconfig.json && tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "aria-snapshot": "^0.2.0",
    "jsdom": "^24.0.0"
  },
  "peerDependencies": {
    "cypress": ">=15"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "cypress": "^15.18.0",
    "typescript": "^6.0.3",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "cypress",
    "cypress-plugin",
    "self-healing",
    "testing",
    "e2e",
    "ai",
    "test-maintenance"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adam-s/goldseam.git",
    "directory": "packages/goldseam"
  },
  "bugs": {
    "url": "https://github.com/adam-s/goldseam/issues"
  },
  "homepage": "https://github.com/adam-s/goldseam#readme",
  "author": "Adam Sohn"
}
